# ─────────────────────────────────────────────────────────────────────────────
# Solana Token Early Tracker — environment configuration
#
# Copy this file to .env and fill in your values.
# Every variable has a built-in default; you only need to set the ones you
# want to override or that have no sensible default (API keys, credentials).
# ─────────────────────────────────────────────────────────────────────────────


# ── X (Twitter) auth ──────────────────────────────────────────────────────────
# Used for headless login. If you have cookies.json already, these are optional.
X_USERNAME=your_username
X_EMAIL=your@email.com
X_PASSWORD=your_password

# Override the GraphQL query ID used by twikit's search_timeline call.
# Leave blank to use twikit's built-in list (which we rotate on 404).
TWITTER_SEARCH_QID=


# ── API keys ──────────────────────────────────────────────────────────────────
# Required if CANDLE_PROVIDER=birdeye. Free tier: 10k req/month, 1 req/sec.
# Sign up at: https://birdeye.so/
BIRDEYE_API_KEY=

# Optional — for future wallet-linking feature (Helius RPC).
HELIUS_API_KEY=

# Optional — for future wallet-labeling feature (Solscan).
SOLSCAN_API_KEY=

# Optional — Telegram alerts (future feature).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — Discord alerts (future feature).
DISCORD_WEBHOOK_URL=


# ── Candle data source ────────────────────────────────────────────────────────
# "dexscreener" uses io.dexscreener.com (currently returns 403 — blocked by CF).
# "birdeye"     uses the documented Birdeye OHLCV API (requires BIRDEYE_API_KEY).
CANDLE_PROVIDER=dexscreener

# How many days of 1-minute candles to fetch per call (covers all time windows).
CANDLE_FETCH_DAYS=7


# ── Outcome tracking ──────────────────────────────────────────────────────────
# Set false to skip the automatic outcome check after each token lookup.
OUTCOME_CHECK_ENABLED=true

# Minimum age of a call (minutes) before its outcome is first checked.
# Must be ≥ 24*60 to have a full 24h window; 60 is fine for incremental checks.
OUTCOME_CHECK_DELAY_MIN=60

# Hours to wait before re-checking a call that was already checked but is still
# pending (e.g. not enough time has passed for the 24h window to close).
OUTCOME_CHECK_BACKOFF_HOURS=24

# Maximum calls to check in a single --update-outcomes run (0 = unlimited).
OUTCOME_BATCH_SIZE=50

# Milliseconds to sleep between Birdeye API calls (free tier: 1 req/sec = 1000ms).
# Add a small buffer; 1100ms avoids occasional rate-limit spikes.
OUTCOME_DELAY_MS=1100

# Seconds to sleep between consecutive outcome checks within a batch.
INTER_OUTCOME_SLEEP_S=0.5


# ── Outcome classification thresholds ─────────────────────────────────────────
# These define the boundaries used by classify_outcome() and the GUI labels.
# Must satisfy: MOONSHOT > BIG_WIN > WIN > 1.0
THRESHOLD_MOONSHOT=10.0       # best 24h multiple ≥ this → "moonshot"
THRESHOLD_BIG_WIN=5.0         # best 24h multiple ≥ this → "big_win"
THRESHOLD_WIN=2.0             # best 24h multiple ≥ this → "win"
THRESHOLD_RUG_DRAWDOWN=-0.50  # 1h drawdown below this (and price < 1x) → "rug"


# ── HTTP / retry ──────────────────────────────────────────────────────────────
HTTP_TIMEOUT_PAIR=15      # seconds — timeout for DexScreener pair-address lookups
HTTP_TIMEOUT_CANDLES=20   # seconds — timeout for candle-fetch requests
API_RETRY_ATTEMPTS=4      # number of retry attempts before giving up on an API call


# ── Pump window / tweet search ────────────────────────────────────────────────
# Minutes after pair creation to call the estimated pump peak.
PUMP_PEAK_OFFSET_MIN=15

# How far before the pump peak to start collecting tweets.
DEFAULT_WINDOW_BEFORE_MIN=60

# How far after the pump peak to keep collecting tweets.
DEFAULT_WINDOW_AFTER_MIN=30

# Upper bound on total tweets collected per token search.
DEFAULT_TWEET_LIMIT=200

# Tweets requested per paginated API call (twikit count parameter).
TWEETS_PER_PAGE=20

# Maximum pages to paginate through (TWEETS_PER_PAGE × MAX_SEARCH_PAGES = ceiling).
MAX_SEARCH_PAGES=10


# ── Caller scoring weights ────────────────────────────────────────────────────
# Score = (followers × WEIGHT_FOLLOWERS) + (likes × WEIGHT_LIKES) + (RTs × WEIGHT_RETWEETS)
# Weights should sum to 1.0 — Config.validate() will warn if they don't.
WEIGHT_FOLLOWERS=0.4
WEIGHT_LIKES=0.4
WEIGHT_RETWEETS=0.2


# ── Alerts (future feature) ───────────────────────────────────────────────────
ALERT_MIN_CALLER_SCORE=1000   # minimum caller score to trigger an alert
ALERT_MIN_WIN_RATE=0.5        # minimum win rate (0.0–1.0) to trigger an alert
ALERT_QUIET_HOURS_START=23    # hour (0–23) to start suppressing alerts
ALERT_QUIET_HOURS_END=7       # hour (0–23) to resume alerts


# ── Storage / paths ───────────────────────────────────────────────────────────
WATCHLIST_FILE=watchlist.json
COOKIES_FILE=cookies.json
WALLET_LINKS_FILE=wallet_links.json    # used by future wallet-linking feature
OUTCOMES_LOG_FILE=outcomes_debug.log  # structured per-call debug log

# Logging level for the outcomes logger: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# ── Wallet linking (future feature) ───────────────────────────────────────────
WALLET_LINKING_ENABLED=true
WALLET_LINK_MIN_CALLS=3           # min calls before attempting wallet link
WALLET_LINK_BUY_WINDOW_MIN=5      # minutes around tweet time to look for on-chain buys
